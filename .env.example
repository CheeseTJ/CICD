# 必填：GitHub Personal Access Token（需要 repo 权限，用于读取仓库与私有 Release 资产）
GITHUB_TOKEN=

# 必填：蒲公英 API Key（登录 https://www.pgyer.com/account/api 获取）
PGYER_API_KEY=

# 可选：服务监听端口，默认 8080
PORT=8080

# 可选：状态持久化文件路径，默认 ./data.json
DATA_FILE=./data.json

# 可选：非空时列出指定用户/组织的公开仓库；留空则列出当前登录用户（含私有）仓库
GITHUB_OWNER=

# 可选：用户中心地址，非空即启用登录鉴权；留空则接口完全开放（仅限本机调试）
USER_CENTER_URL=https://user-center.example.workers.dev

# 可选：本服务在用户中心的标识，决定 JWT 的 aud，需与用户中心 APPS 里登记的一致
USER_CENTER_APP=cicd

# 可选：邮箱白名单（逗号分隔），在「用户中心角色必须是 admin」之上再收窄到具体账号。
# 留空表示任何管理员都能访问本面板
ALLOWED_EMAILS=

# 可选：服务健康监控。「名称=健康接口URL」，逗号分隔；留空则「监控」视图显示未配置。
# 例：jmreader=https://jm.example.com/api/schedule,music=https://music.example.com/health
# 探测由浏览器直连完成（服务端不轮询）：目标需返回 Access-Control-Allow-Origin，
# 否则浏览器读不到响应，会显示为「跨域受限」。
HEALTH_TARGETS=

# 可选：本控制台对外访问地址（如 https://cicd.example.com）。
# 仅用于预判各健康接口是否允许本页跨域读取（发 Origin 头时使用）。
PUBLIC_ORIGIN=

# ---------------------------------------------------------------
# 鸿蒙（HarmonyOS）应用：证书到期监控 / 重签 / 同步蒲公英
#
# 签名由三部分组成，缺一不可：
#   keystore(.p12)  私钥，本地生成，长期复用，**换证书时不要换它**
#   cert(.cer)      AGC 签发，有有效期
#   profile(.p7b)   AGC 签发，也有有效期
# 真正失效时间 = 两者较早的那个。到期后已装的包还能跑，但装不了新包。
# ---------------------------------------------------------------

# 可选：鸿蒙应用清单路径，默认与 DATA_FILE 同目录的 hmos.json
HMOS_FILE=

# 可选：华为 hapsigntoolv2.jar 的路径。不配则「重签」按钮不可用，
# 但证书到期时间仍能正常监控（到期检测只读文件，不需要签名工具）。
# 下载：https://repo.huaweicloud.com/harmonyos/develop_tools/hapsigntoolv2.jar
HMOS_SIGN_TOOL=

# 可选：java 可执行文件路径（需 JDK 17+），留空则用 PATH 里的 java
HMOS_JAVA=

# 可选：剩余天数 ≤ 此值视为「即将过期」，默认 30
HMOS_WARN_DAYS=30

# 必填（仅重签时需要）：keystore 与 key 的密码。
# 签名工具需要它才能取私钥；不配则重签会失败并提示缺密码。
HMOS_KEYSTORE_PWD=
