# 必填：GitHub Personal Access Token（需要 repo 权限，用于读取仓库与私有 Release 资产）
GITHUB_TOKEN=

# 必填：蒲公英 API Key（登录 https://www.pgyer.com/account/api 获取）
PGYER_API_KEY=

# 可选：服务监听端口，默认 8080
PORT=8080

# 可选：状态持久化文件路径，默认 ./data.json
DATA_FILE=./data.json

# 可选：非空时列出指定用户/组织的公开仓库；留空则列出当前登录用户（含私有）仓库
GITHUB_OWNER=

# 可选：用户中心地址，非空即启用登录鉴权；留空则接口完全开放（仅限本机调试）
USER_CENTER_URL=https://user-center.example.workers.dev

# 可选：本服务在用户中心的标识，决定 JWT 的 aud，需与用户中心 APPS 里登记的一致
USER_CENTER_APP=cicd

# 可选：邮箱白名单（逗号分隔），在「用户中心角色必须是 admin」之上再收窄到具体账号。
# 留空表示任何管理员都能访问本面板
ALLOWED_EMAILS=

# 可选：服务健康监控。「名称=健康接口URL」，逗号分隔；留空则「监控」视图显示未配置。
# 例：jmreader=https://jm.example.com/api/schedule,music=https://music.example.com/health
# 判定：2xx/3xx=正常；503 或 JSON 里 open=false=暂停开放；其它=不可用
HEALTH_TARGETS=

# 可选：健康探测间隔（Go duration，默认 30s，最小 5s）
MONITOR_INTERVAL=30s
